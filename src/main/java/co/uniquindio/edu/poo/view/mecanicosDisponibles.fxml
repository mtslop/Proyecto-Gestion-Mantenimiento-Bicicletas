<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.poo.controller.MecanicosDisponiblesController" style="-fx-background-color: #121417;" prefHeight="600" prefWidth="650">
 <VBox layoutX="25" layoutY="25" prefWidth="600" spacing="14" style="-fx-background-color: #1A1D23; -fx-background-radius: 12; -fx-padding: 20;">
  <Label text="MECÁNICOS DISPONIBLES" style="-fx-text-fill: #F4F4F6; -fx-font-size: 18px; -fx-font-weight: bold;"/>
  <Label text="Personal disponible para asignar a una orden de servicio" style="-fx-text-fill: #A0A5AD;"/>
  <TableView fx:id="tblMecanicos" prefHeight="400" style="-fx-background-color: #2A2E35; -fx-control-inner-background: #2A2E35;">
   <columns><TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="200"/><TableColumn fx:id="colEspecialidad" text="Especialidad" prefWidth="250"/><TableColumn fx:id="colCodigo" text="Código interno" prefWidth="130"/></columns>
  </TableView>
 </VBox>
</AnchorPane>
