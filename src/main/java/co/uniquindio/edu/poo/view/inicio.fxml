<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.uniquindio.edu.poo.controller.InicioController" style="-fx-background-color: #121417;">
 <left><VBox prefWidth="220" spacing="10" style="-fx-background-color: #1A1D23; -fx-padding: 24;"><Label text="BIKE CARE" style="-fx-text-fill: #FF5722; -fx-font-size: 23px; -fx-font-weight: bold;"/><Label text="Gestión del taller" style="-fx-text-fill: #A0A5AD; -fx-padding: 0 0 20 0;"
 /><Button text="Regitrar Cliente" onAction="#cargarRegistroCliente" maxWidth="Infinity" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6;"
 /><Button text="Registrar Bicicleta" onAction="#cargarRegistroBicicleta" maxWidth="Infinity" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6;"
 /><Button text="Registrar Mecánico" onAction="#cargarRegistroMecanico" maxWidth="Infinity" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6;"
 /><Button text="Mecánicos disponibles" onAction="#cargarMecanicosDisponibles" maxWidth="Infinity" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6;"
 /><Button text="Historial por serial" onAction="#cargarHistorial" maxWidth="Infinity" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6;"
 /><Button text="Órdenes del día" onAction="#cargarOrdenesDia" maxWidth="Infinity" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6;"
 /><Button text="Nueva orden" onAction="#cargarOrdenServicio" maxWidth="Infinity" style="-fx-background-color: #FF5722; -fx-text-fill: #F4F4F6; -fx-font-weight: bold;"
 /></VBox></left>
 <center><StackPane fx:id="contenedorVistas"/></center>
</BorderPane>
