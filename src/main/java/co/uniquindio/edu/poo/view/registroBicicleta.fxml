<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="450.0" style="-fx-background-color: #121417;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="50.0" layoutY="30.0" prefHeight="590.0" prefWidth="350.0" spacing="10.0" style="-fx-background-color: #1A1D23; -fx-background-radius: 12px; -fx-padding: 20px;">
            <children>
                <Label text="REGISTRO DE BICICLETA" textFill="#F4F4F6">
                    <font>
                        <Font name="Segoe UI Bold" size="18.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Label>

                <Label text="Nombre del Cliente" textFill="#A0A5AD">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNombreCliente" promptText="Ej: Juan Pérez" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6; -fx-prompt-text-fill: #6C727D; -fx-background-radius: 6px; -fx-padding: 6px;" />

                <Label text="Teléfono del Cliente" textFill="#A0A5AD">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtTelefonoCliente" promptText="Ej: 3101234567" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6; -fx-prompt-text-fill: #6C727D; -fx-background-radius: 6px; -fx-padding: 6px;" />

                <Label text="Marca" textFill="#A0A5AD">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtMarca" promptText="Ej:Gw" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6; -fx-prompt-text-fill: #6C727D; -fx-background-radius: 6px; -fx-padding: 6px;" />

                <Label text="Tipo" textFill="#A0A5AD">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtModelo" promptText="Ej:Electrica" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6; -fx-prompt-text-fill: #6C727D; -fx-background-radius: 6px; -fx-padding: 6px;" />

                <Label text="Color" textFill="#A0A5AD">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtColor" promptText="Ej:Negro" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6; -fx-prompt-text-fill: #6C727D; -fx-background-radius: 6px; -fx-padding: 6px;" />

                <Label text="Serial" textFill="#A0A5AD">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtSerial" promptText="Ej: SN987654321" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6; -fx-prompt-text-fill: #6C727D; -fx-background-radius: 6px; -fx-padding: 6px;" />

                <Label text="Año" textFill="#A0A5AD">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="txtAnio" promptText="Ej: 2024" style="-fx-background-color: #2A2E35; -fx-text-fill: #F4F4F6; -fx-prompt-text-fill: #6C727D; -fx-background-radius: 6px; -fx-padding: 6px;" />

                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleRegistrarBicicleta" prefHeight="38.0" prefWidth="300.0" style="-fx-background-color: #FF5722; -fx-text-fill: #F4F4F6; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6px;" text="Registrar Bicicleta">
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>
